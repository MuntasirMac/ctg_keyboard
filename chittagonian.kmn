c Chittagonian Mobile Keyboard Layout with Shift Layer
store(&VERSION) '10.0'
store(&NAME) 'Sitainga'
store(&TARGETS) 'mobile web'
store(&LAYOUTFILE) 'chittagonian.keyman-touch'
store(&KEYBOARDVERSION) '1.0.1'

c These two statements below are strictly mandatory to bypass error KM0200F
store(&ETHNOLOGUECODE) 'ctg'
store(&LANGUAGE) 'x0445'

store(&CasedKeys) [U_0061] .. [U_007A]

begin Unicode > use(main)
begin NewContext > use(NewContext)
begin PostKeystroke > use(PostKeystroke)

group(main) using keys
+ [U_0111] > 'đ'
+ [U_1E0D] > 'ḍ'
+ [U_0167] > 'ŧ'
+ [U_1E6D] > 'ṭ'
+ [U_00F1] > 'ñ'
+ [U_1E45] > 'ṅ'
+ [U_0254] > 'ɔ'
+ [U_E001] > 'ɔ́'
+ [U_E002] > 'ɔ̌'
+ [U_E003] > 'ɔ̂'
+ [U_E004] > 'ɔ̃'
+ [SHIFT U_0110] > 'Đ'
+ [SHIFT U_1E0C] > 'Ḍ'
+ [SHIFT U_0166] > 'Ŧ'
+ [SHIFT U_1E6C] > 'Ṭ'
+ [SHIFT U_00D1] > 'Ñ'
+ [SHIFT U_1E44] > 'Ṅ'
+ [SHIFT U_0186] > 'Ɔ'
+ [SHIFT U_E005] > 'Ɔ́'
+ [SHIFT U_E006] > 'Ɔ̌'
+ [SHIFT U_E007] > 'Ɔ̂'
+ [SHIFT U_E008] > 'Ɔ̃'

store(sentencePunctuation) '.?!'
store(whitespace) ' ' U+00A0 U+000D U+000A U+0009

group(NewContext) readonly
    platform('touch') > use(detectStartOfSentence)

group(PostKeystroke) readonly
    platform('touch') if(&newLayer = "") > use(detectStartOfSentence)

group(detectStartOfSentence) readonly
    nul > layer('shift')
    any(sentencePunctuation) any(whitespace) > layer('shift')
    any(sentencePunctuation) any(whitespace) any(whitespace) > layer('shift')
    any(sentencePunctuation) any(whitespace) any(whitespace) any(whitespace) > layer('shift')
    nomatch > layer('default')
